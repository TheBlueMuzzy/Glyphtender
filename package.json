{
  "name": "glyphtender",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check:devkit": "node src/devkit/check-devkit.mjs",
    "check:ui": "node src/ui/kit/check-ui.mjs src/ui src/game --css src",
    "e2e:sketch": "node e2e/sketch-shots.mjs",
    "e2e:menu": "node e2e/menu-shots.mjs",
    "e2e:game": "node e2e/game-shots.mjs",
    "e2e:pass": "node e2e/pass-and-play-shots.mjs",
    "e2e:pass4": "node e2e/pass-and-play-shots.mjs e2e-shots 5194 4",
    "sim": "node scripts/sim.mjs",
    "sim:awards": "node scripts/award-rates.mjs",
    "party:dev": "wrangler dev --persist-to .wrangler/state-dev",
    "party:deploy": "wrangler deploy",
    "e2e:online": "node e2e/online-shots.mjs",
    "e2e:online4": "node e2e/online-four.mjs",
    "e2e:update": "node e2e/sw-update.mjs",
    "e2e:portrait": "node e2e/portrait-layout.mjs",
    "e2e:spotlight": "node e2e/word-spotlight.mjs",
    "e2e:score": "node e2e/score-sequence.mjs",
    "e2e:previews": "node e2e/previews.mjs",
    "e2e:end": "node e2e/end-screen-shots.mjs",
    "e2e:margins": "node e2e/layout-margins.mjs",
    "e2e:trails": "node e2e/trail-shots.mjs",
    "fixtures:end": "node scripts/end-fixtures.mjs",
    "e2e:devkit-search": "node e2e/devkit-search.mjs",
    "e2e:fullscreen": "node e2e/fullscreen.mjs"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
