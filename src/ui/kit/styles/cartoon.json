{
  "bg": "#8fd8ff",
  "on-bg": "#1d1a33",
  "surface": "#ffffff",
  "on-surface": "#1d1a33",
  "primary": "#ffc629",
  "on-primary": "#1d1a33",
  "accent": "#3ccf62",
  "danger": "#d42b44",
  "on-danger": "#ffffff",
  "muted": "#56506e",
  "border": "#1d1a33",
  "focus": "#7a2cf5",
  "ink": "#1d1a33",
  "on-game": "#ffffff",
  "game-shade": "#1d1a33",
  "font-display": "'Lilita One', 'Fredoka', system-ui, sans-serif",
  "font-body": "'Fredoka', ui-rounded, system-ui, sans-serif",
  "font-numbers": "var(--font-display)",
  "text-size": 1,
  "font-scale": 1.28,
  "radius-control": "999px",
  "radius-panel": "1.5rem",
  "corner-shape": "round",
  "density": 1,
  "depth-0": "inset 0 -4px 0 rgb(0 0 0 / 0.14), 0 5px 0 #1d1a33",
