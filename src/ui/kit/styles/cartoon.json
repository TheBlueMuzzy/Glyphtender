  "depth-2": "0 10px 0 #1d1a33",
  "border-width": "3px",
  "glow": "none",
  "panel-texture": "none",
  "text-case": "none",
  "motion-fast": "160ms",
  "motion-normal": "420ms",
  "press-scale": 1,
  "press-shift": "5px",
  "ease": "cubic-bezier(0.34, 1.7, 0.5, 1)",
  "enter": "kit-pop"
}
